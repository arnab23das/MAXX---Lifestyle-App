# Copy this file to .env and fill in your own Supabase project values.
# These are public (anon key is safe client-side under RLS) and must be
# prefixed EXPO_PUBLIC_ so Expo inlines them into the client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for "Sign in with Google" (expo-auth-session).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
